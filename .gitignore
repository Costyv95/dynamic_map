# Home Assistant
# NOTE (#300): no trailing slash — a `foo/` rule matches a DIRECTORY only and
# silently stops applying once the path is a symlink (worktree recipe). `.storage`
# holds HA auth tokens/integration secrets — vault_dev's .state/pg.url analog —
# so a symlinked `.storage` (e.g. to a live HA store) must not escape this rule.
.storage
*.log
*.log.*
ha_test

# Windows / OS Files
*Zone.Identifier
Thumbs.db
.DS_Store

# Python
__pycache__
*.pyc
.venv
env

# JavaScript / Node
# NOTE: no trailing slash — a `foo/` rule matches a DIRECTORY only, so it
# SILENTLY STOPS applying if the path becomes a symlink (the standard
# ~/.agent-worktrees recipe symlinks node_modules), letting `git add -A` sweep
# a mode-120000 blob into the tree and damage the shared checkout at MERGE time.
# Bare `node_modules` matches a dir, file, OR symlink. (cortex, disc #300)
node_modules
custom_components/dynamic_map/frontend/node_modules
.vitest
.coverage

# Map Generation Debug Outputs
debug_*.png
raw_debug_*.png
raw_floor*.png
cv2_mask_*.png
crop_floor*.png
test_*.png
contour_output.txt

# User Data (Private)
rooms_floor*.json
shortcuts_floor*.json
floor*.png
bg_floor*.png
floor*.svg
floor*.dxf

# Misc
.env
*.tmp
